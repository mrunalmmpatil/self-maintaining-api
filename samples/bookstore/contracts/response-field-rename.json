{
  "openapi": "3.0.3",
  "info": {
    "title": "Bookstore",
    "version": "2.0"
  },
  "paths": {
    "/books/{book_id}": {
      "get": {
        "operationId": "getBook",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "required": [
          "id",
          "price",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "price": {
            "type": "number",
            "description": "Unit price in US dollars."
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
