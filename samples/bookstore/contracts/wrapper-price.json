{
  "openapi": "3.0.3",
  "info": {
    "title": "Bookstore",
    "version": "2.0"
  },
  "paths": {
    "/books/{book_id}": {
      "get": {
        "operationId": "getBook",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "required": [
          "id",
          "title",
          "pricing"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "pricing": {
            "type": "object",
            "required": [
              "amount_cents",
              "currency"
            ],
            "properties": {
              "amount_cents": {
                "type": "integer",
                "description": "US cents. Divide by 100 to obtain the former price in dollars."
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD"
                ]
              }
            }
          }
        }
      }
    }
  }
}
