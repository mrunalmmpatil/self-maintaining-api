# Backend only. Copy to .env; CLI/server/workers load it on startup.
# Existing exported environment variables take precedence. Restart after edits.
OPENROUTER_API_KEY=
# Allowlisted in config.APPROVED_MODELS. The :free variants are rate-limited per minute
# regardless of credit balance and will 429 mid-run; use a paid model for scored runs.
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Optional shared storage location (CLI and API must use the same value).
# API_MAINTAINER_DATA=/absolute/path/to/local-data
