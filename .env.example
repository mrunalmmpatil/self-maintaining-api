# Backend only. Copy to .env; CLI/server/workers load it on startup.
# Existing exported environment variables take precedence. Restart after edits.
OPENROUTER_API_KEY=
# Must be listed in config.APPROVED_MODELS, which holds free models only — there is no
# paid fallback. Free models are rate-limited per minute and can 429 mid-run; re-run the
# scenario rather than switching to a paid model.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional shared storage location (CLI and API must use the same value).
# API_MAINTAINER_DATA=/absolute/path/to/local-data
